# ─── Server ───────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────
# Local: mongodb://localhost:27017/pan_afri_journal
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/pan_afri_journal
MONGODB_URI=mongodb://localhost:27017/pan_afri_journal

# ─── JWT (REQUIRED — generate strong random strings) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ─── Cloudinary (file uploads) ────────────────────────
# Get these from https://console.cloudinary.com/settings
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email (SMTP) ────────────────────────────────────
# For Gmail: enable "App Passwords" at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@panafrijournal.org

# ─── URLs ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5000

# ─── File Uploads ─────────────────────────────────────
MAX_FILE_SIZE=10485760
