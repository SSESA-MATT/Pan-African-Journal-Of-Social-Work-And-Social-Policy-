# Copy this file to .env.local (or set env vars) and update values as needed.
# Example DATABASE_URL: postgres://postgres:postgres@localhost:5432/pan_afri_local
DATABASE_URL="postgres://postgres:postgres@localhost:5432/pan_afri_local"

# Supabase placeholders (if you use Supabase locally or remotely)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="anon-key-here"
SUPABASE_SERVICE_ROLE_KEY="service-role-key-here"

# Other common envs used by the backend (examples)
PORT=4000
NODE_ENV=development
